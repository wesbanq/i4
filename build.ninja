# i4 — Ninja + Clang. Run from the repository root.
#
# First-time build: run `ninja` — generates build/I4Version.h, then compiles (Main.o waits on that header).
# Prerequisites: clang++, llvm-ar, POSIX sh (e.g. Git Bash on Windows). Git optional.
#
#   ninja
#   ninja -t compdb cxx > compile_commands.json   # rule name: cxx; refresh after new .cpp
#
# builddir is set below (change `builddir = ...` to use another output directory).
#
# Requires: clang++, llvm-ar (LLVM bin on PATH). Git in PATH for version strings (optional).
# Keep compile_flags.txt and compile_commands.json in sync with cflags / cxx rules (clangd).
#
# Version: i4cli/I4Version.h.in + scripts/gen_version.sh (git describe, else unknown) -> $builddir/I4Version.h
# Binary: $builddir/i4, or $builddir/i4.exe when $cxx targets Windows (scripts/link.sh decides).

builddir = build

cxx = clang++
ar = llvm-ar
cflags = -std=c++20 -O0 -g -Wall -Wextra -I i4core -I $builddir

rule gen_version
  command = sh scripts/gen_version.sh $in $out
  description = GEN I4Version.h
  restat = 1

rule cxx
  depfile = $out.d
  deps = gcc
  command = $cxx -c $in -o $out $cflags -MMD -MF $out.d
  description = CXX $in

rule ar
  command = $ar rcs $out $in
  description = AR $out

rule link
  command = sh scripts/link.sh $cxx $bin $out $in
  description = LINK $bin

build $builddir/I4Version.h: gen_version i4cli/I4Version.h.in | scripts/gen_version.sh

build $builddir/i4core/Interpreter.o: cxx i4core/Interpreter.cpp
build $builddir/i4core/Runner.o: cxx i4core/Runner.cpp
build $builddir/i4core/DebugRunner.o: cxx i4core/DebugRunner.cpp
build $builddir/i4core/StackFile.o: cxx i4core/StackFile.cpp
build $builddir/i4core/StackWord.o: cxx i4core/StackWord.cpp
build $builddir/i4cli/Main.o: cxx i4cli/Main.cpp | $builddir/I4Version.h

build $builddir/i4core/libi4core.a: ar $builddir/i4core/Interpreter.o $builddir/i4core/Runner.o $builddir/i4core/DebugRunner.o $builddir/i4core/StackFile.o $builddir/i4core/StackWord.o

build $builddir/i4.stamp: link $builddir/i4cli/Main.o $builddir/i4core/libi4core.a | scripts/link.sh
  bin = $builddir/i4

build i4: phony $builddir/i4.stamp

default i4
